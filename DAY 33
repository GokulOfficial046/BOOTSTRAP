<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bootstrap Practice</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <!-- Container -->
    <div class="container mt-5">

        <!-- Heading Section -->
        <div class="text-center mb-4 p-3 bg-light">
            <h1 class="text-primary">Welcome to Bootstrap</h1>
            <p class="text-muted">This is a simple Bootstrap setup example</p>
        </div>

        <!-- Content Section -->
        <div class="p-4 mb-4 bg-secondary text-white rounded">
            <h2 class="mb-3">Typography Example</h2>
            <p>
                Bootstrap provides many utility classes for styling text easily.
                You can align text, change colors, and add spacing without writing custom CSS.
            </p>
        </div>

        <!-- Another Section -->
        <div class="p-3 bg-warning text-dark text-center">
            <h3>Spacing Utilities</h3>
            <p class="mt-2">
                Margin (m-) and Padding (p-) help create space between elements.
            </p>
        </div>

    </div>

</body>
</html>
